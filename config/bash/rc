# Nanuk — defaults de bash. NO EDITAR: se reemplaza en cada update.
# Tus alias y funciones: ~/.config/nanuk/user/bash/rc (se carga después).

# Solo en shells interactivas (scripts y scp no necesitan nada de esto).
[[ $- != *i* ]] && return

export EDITOR=nvim
export VISUAL=nvim
export PATH="$HOME/.local/bin:$PATH"

# ── Alias ──────────────────────────────────────────────────────────
alias ls='eza --group-directories-first'
alias ll='eza -l --group-directories-first --git'
alias la='eza -la --group-directories-first --git'
alias lt='eza --tree --level=2 --group-directories-first'
alias ..='cd ..'
alias grep='grep --color=auto'
alias lg='lazygit'
alias ld='lazydocker'
alias dc='docker compose'

# ── Herramientas interactivas ──────────────────────────────────────
command -v starship >/dev/null && eval "$(starship init bash)"
command -v zoxide   >/dev/null && eval "$(zoxide init bash)"     # `z carpeta`
command -v fzf      >/dev/null && eval "$(fzf --bash)"           # Ctrl+R, Ctrl+T
command -v mise     >/dev/null && eval "$(mise activate bash)"   # versiones de node/python/php
