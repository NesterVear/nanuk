// Nanuk — fastfetch: la cara de un oso polar, de frente, en ASCII al abrir la
// terminal (nanuk.txt, medios bloques). El splash y el lock siguen con el oso de lado.
// Blanco y gris, pocos módulos. Se enlaza en ~/.config/fastfetch (06-dotfiles).
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/nanuk.txt",
    "color": { "1": "white", "2": "90" },
    "padding": { "top": 1, "right": 5, "left": 2 }
  },
  "display": {
    "separator": "  ",
    // "90" = gris claro de la paleta de la terminal (color8). OJO: el nombre
    // "bright_black" fastfetch lo traduce a negro en negrita (\e[1;30m) y en
    // kitty las etiquetas quedaban negro sobre negro.
    "color": { "keys": "90", "title": "white" },
    // Todas las etiquetas del mismo ancho: los valores quedan en columna. El
    // ancho cuenta la etiqueta más el hueco: 12 deja dos espacios tras la más
    // larga, "encendido".
    "key": { "width": 12 }
  },
  "modules": [
    { "type": "title", "format": "{user-name}@{host-name}" },
    { "type": "custom", "format": "" },
    { "type": "os",       "key": "sistema" },
    { "type": "kernel",   "key": "kernel" },
    { "type": "wm",       "key": "wm" },
    { "type": "terminal", "key": "terminal" },
    { "type": "uptime",   "key": "encendido" },
    { "type": "memory",   "key": "memoria" }
  ]
}
