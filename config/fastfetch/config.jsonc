// Nanuk — fastfetch: el oso polar en ASCII al abrir la terminal.
// Blanco y gris, pocos módulos. Se enlaza en ~/.config/fastfetch (06-dotfiles).
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/nanuk.txt",
    "color": { "1": "white", "2": "bright_black" },
    "padding": { "top": 1, "right": 5, "left": 2 }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "bright_black", "title": "white" }
  },
  "modules": [
    { "type": "title", "format": "{user-name}@{host-name}" },
    { "type": "custom", "format": "" },
    { "type": "os",       "key": "sistema" },
    { "type": "kernel",   "key": "kernel" },
    { "type": "wm",       "key": "wm" },
    { "type": "terminal", "key": "terminal" },
    { "type": "uptime",   "key": "encendido" },
    { "type": "packages", "key": "paquetes" },
    { "type": "memory",   "key": "memoria" },
    { "type": "custom", "format": "" },
    { "type": "colors", "symbol": "block", "paddingLeft": 0 }
  ]
}
