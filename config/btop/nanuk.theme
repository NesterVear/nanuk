# Nanuk — tema de btop. Negro, blanco, grises; hielo solo en el elemento con foco.
# Se enlaza en ~/.config/btop/themes/nanuk.theme (06-dotfiles).
theme[main_bg]="#000000"
theme[main_fg]="#ffffff"
theme[title]="#ffffff"
theme[hi_fg]="#9fd8ff"
theme[selected_bg]="#141414"
theme[selected_fg]="#ffffff"
theme[inactive_fg]="#707070"
theme[graph_text]="#b0b0b0"
theme[meter_bg]="#1e1e1e"
theme[proc_misc]="#b0b0b0"
theme[cpu_box]="#333333"
theme[mem_box]="#333333"
theme[net_box]="#333333"
theme[proc_box]="#333333"
theme[div_line]="#333333"
theme[temp_start]="#a0b0a0"
theme[temp_mid]="#b0b0a0"
theme[temp_end]="#b0a0a0"
theme[cpu_start]="#707070"
theme[cpu_mid]="#b0b0b0"
theme[cpu_end]="#ffffff"
theme[free_start]="#707070"
theme[free_mid]="#b0b0b0"
theme[free_end]="#ffffff"
theme[cached_start]="#707070"
theme[cached_mid]="#b0b0b0"
theme[cached_end]="#ffffff"
theme[available_start]="#707070"
theme[available_mid]="#b0b0b0"
theme[available_end]="#ffffff"
theme[used_start]="#707070"
theme[used_mid]="#b0b0b0"
theme[used_end]="#ffffff"
theme[download_start]="#707070"
theme[download_mid]="#b0b0b0"
theme[download_end]="#ffffff"
theme[upload_start]="#707070"
theme[upload_mid]="#b0b0b0"
theme[upload_end]="#ffffff"
theme[process_start]="#707070"
theme[process_mid]="#b0b0b0"
theme[process_end]="#ffffff"
