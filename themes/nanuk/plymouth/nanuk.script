# Tema Plymouth de Nanuk.
#
# Basado en el tema de Omarchy (MIT — https://github.com/basecamp/omarchy):
# se conserva su lógica de progreso (falso hasta que el kernel da progreso
# real) y de diálogo de contraseña LUKS. Cambios de Nanuk: fondo negro,
# wordmark, y la barra de progreso es Pac-Man comiéndose una fila de monedas.
#
# Lenguaje: plymouth-script.
# https://www.freedesktop.org/wiki/Software/Plymouth/Scripts/

Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);

# ── Logo (wordmark) centrado ────────────────────────────────────────
logo.image = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.sprite.SetX(Window.GetWidth() / 2 - logo.image.GetWidth() / 2);
logo.sprite.SetY(Window.GetHeight() / 2 - logo.image.GetHeight() / 2);
logo.sprite.SetOpacity(1);

# ── Estado ──────────────────────────────────────────────────────────
# Mientras el disco se descifra el kernel no reporta progreso: la barra
# (Pac-Man) avanza sola hasta fake_progress_limit y luego cede al progreso
# real cuando este la supera.
global.fake_progress_limit = 0.7;      # hasta dónde llega solo (0.0 - 1.0)
global.fake_progress_duration = 15.0;  # en cuántos segundos

global.animation_frame = 0;
global.fake_progress = 0.0;
global.real_progress = 0.0;
global.fake_progress_active = 0;
global.fake_progress_start_time = 0.0;
global.password_shown = 0;
global.max_progress = 0.0;   # nunca retrocede
global.chomp = 0;            # contador para alternar la boca
global.pac_visible = 0;

# ── Bucle de animación (≈50 FPS) ────────────────────────────────────
fun refresh_callback() {
  global.animation_frame++;

  # Masticar: ~5 mordiscos por segundo (50 FPS / 10).
  global.chomp++;
  if (global.chomp >= 10) global.chomp = 0;
  if (global.pac_visible == 1) {
    if (global.chomp < 5) pac.sprite.SetImage(pac.image_a);
    else pac.sprite.SetImage(pac.image_b);
  }

  if (global.fake_progress_active == 1) {
    elapsed_time = global.animation_frame / 50.0;
    time_ratio = elapsed_time / global.fake_progress_duration;
    if (time_ratio > 1.0) time_ratio = 1.0;

    # ease-out cuadrático: 1 - (1 - x)^2
    eased_ratio = 1 - ((1 - time_ratio) * (1 - time_ratio));
    global.fake_progress = eased_ratio * global.fake_progress_limit;
    update_pac(global.fake_progress);
  }
}

Plymouth.SetRefreshFunction(refresh_callback);

# ── Helpers ─────────────────────────────────────────────────────────

# Mueve a Pac-Man a la posición del progreso y "come" las monedas que deja atrás.
fun update_pac(progress) {
  if (progress > global.max_progress) {
    global.max_progress = progress;

    x = track.x + progress * track.width;
    pac.sprite.SetX(x);

    for (i = 0; i < track.count; i++) {
      if (pellet.px[i] < x + 4) pellet.sprites[i].SetOpacity(0);
    }
  }
}

fun show_pac() {
  global.pac_visible = 1;
  global.max_progress = 0.0;
  pac.sprite.SetX(track.x);
  pac.sprite.SetOpacity(1);
  for (i = 0; i < track.count; i++) pellet.sprites[i].SetOpacity(1);
}

fun hide_pac() {
  global.pac_visible = 0;
  pac.sprite.SetOpacity(0);
  for (i = 0; i < track.count; i++) pellet.sprites[i].SetOpacity(0);
}

fun show_password_dialog() {
  entry.sprite.SetOpacity(1);
}

fun hide_password_dialog() {
  entry.sprite.SetOpacity(0);
  for (index = 0; bullet.sprites[index]; index++) {
    bullet.sprites[index].SetOpacity(0);
  }
}

fun start_fake_progress() {
  global.fake_progress_active = 1;
  global.animation_frame = 0;
  global.max_progress = 0.0;
  global.fake_progress = 0.0;
  global.fake_progress_start_time = 0.0;
}

fun stop_fake_progress() {
  global.fake_progress_active = 0;
}

# ── Diálogo de contraseña (LUKS) ────────────────────────────────────
entry.image = Image("entry.png");
bullet.image = Image("bullet.png");

entry.sprite = Sprite(entry.image);
entry.x = Window.GetWidth() / 2 - entry.image.GetWidth() / 2;
entry.y = logo.sprite.GetY() + logo.image.GetHeight() + 40;
entry.sprite.SetPosition(entry.x, entry.y, 10001);
entry.sprite.SetOpacity(0);

bullet.sprites = [];

fun display_normal_callback() {
  hide_password_dialog();

  mode = Plymouth.GetMode();
  if ((mode == "boot" || mode == "resume") && global.password_shown == 1) {
    show_pac();
    start_fake_progress();
  }
}

fun display_password_callback(prompt, bullets) {
  global.password_shown = 1;

  stop_fake_progress();
  hide_pac();
  show_password_dialog();

  for (index = 0; bullet.sprites[index]; index++) {
    bullet.sprites[index].SetOpacity(0);
  }

  max_bullets = 21;
  bullets_to_show = bullets;
  if (bullets_to_show > max_bullets) bullets_to_show = max_bullets;

  for (index = 0; index < bullets_to_show; index++) {
    if (!bullet.sprites[index]) {
      scaled_bullet = bullet.image.Scale(7, 7);
      bullet.sprites[index] = Sprite(scaled_bullet);
      bullet.x = entry.x + 20 + index * (7 + 5);
      bullet.y = entry.y + entry.image.GetHeight() / 2 - 3.5;
      bullet.sprites[index].SetPosition(bullet.x, bullet.y, 10002);
    }
    bullet.sprites[index].SetOpacity(1);
  }
}

Plymouth.SetDisplayNormalFunction(display_normal_callback);
Plymouth.SetDisplayPasswordFunction(display_password_callback);

# ── Pac-Man y su pista de monedas ──────────────────────────────────
pac.image_a = Image("pac_a.png");   # boca casi cerrada
pac.image_b = Image("pac_b.png");   # boca abierta
pac.h = pac.image_a.GetHeight();

track.width = 420;
track.count = 16;
track.x = Window.GetWidth() / 2 - track.width / 2;
# A la misma altura que el campo de contraseña (se turnan en el tiempo).
track.y = entry.y + entry.image.GetHeight() / 2 - pac.h / 2;

pac.sprite = Sprite();
pac.sprite.SetImage(pac.image_a);
pac.sprite.SetPosition(track.x, track.y, 5);
pac.sprite.SetOpacity(0);

pellet.image = Image("pellet.png");
pellet.h = pellet.image.GetHeight();
pellet.sprites = [];
pellet.px = [];
spacing = track.width / (track.count + 1);

for (i = 0; i < track.count; i++) {
  px = track.x + (i + 1) * spacing;
  pellet.px[i] = px;
  pellet.sprites[i] = Sprite(pellet.image);
  pellet.sprites[i].SetPosition(px, track.y + pac.h / 2 - pellet.h / 2, 4);
  pellet.sprites[i].SetOpacity(0);
}

# ── Progreso real del kernel ───────────────────────────────────────
fun progress_callback(duration, progress) {
  if (global.fake_progress_start_time == 0.0) {
    global.fake_progress_start_time = duration;
  }
  global.real_progress = progress;

  if (duration > global.fake_progress_start_time && progress > global.fake_progress) {
    stop_fake_progress();
    update_pac(progress);
  }
}

Plymouth.SetBootProgressFunction(progress_callback);

# ── Mensajes del sistema (fsck, errores) ───────────────────────────
message_sprite = Sprite();
message_sprite.SetPosition(10, 10, 10000);

fun display_message_callback(text) {
  message = Image.Text(text, 1, 1, 1);   # blanco
  message_sprite.SetImage(message);
  message_sprite.SetOpacity(1);
}

fun hide_message_callback(text) {
  message_sprite.SetOpacity(0);
}

Plymouth.SetDisplayMessageFunction(display_message_callback);
Plymouth.SetHideMessageFunction(hide_message_callback);
