#!/usr/bin/env bash
# nanuk-keys — chuleta de atajos de teclado de Hyprland, buscable en fuzzel.
# Muestra solo los que tienen descripción (los que define n.bind).
set -euo pipefail

command -v hyprctl >/dev/null || { echo "Hyprland no está corriendo" >&2; exit 1; }

hyprctl binds -j | jq -r '
  def mods($m):
    [ (if ((($m/64)|floor)%2)==1 then "Super" else empty end),
      (if ((($m/8) |floor)%2)==1 then "Alt"   else empty end),
      (if ((($m/4) |floor)%2)==1 then "Ctrl"  else empty end),
      (if ((($m/1) |floor)%2)==1 then "Shift" else empty end) ]
    | join(" + ");
  .[]
  | select(.description != null and .description != "")
  | (mods(.modmask)) as $m
  | "\(if $m == "" then "" else $m + " + " end)\(.key)\t\(.description)"
' | sort -u | column -t -s $'\t' \
  | fuzzel --dmenu --prompt "atajos ❯ " --width 80 --lines 18 >/dev/null || true
