#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────────
# nanuk — la CLI del sistema.
#
# Idea central: en Nanuk conviven repos oficiales, AUR y flatpak, y da igual
# de dónde venga cada programa. `nanuk install foo` lo busca en los tres,
# lo instala, y lo APUNTA en tu lista personal para que sobreviva a una
# reinstalación (`nanuk sync` en la máquina nueva lo vuelve a poner todo).
#
#   nanuk install <paquete...>   instala (repo | AUR | flatpak, lo detecta)
#   nanuk remove  <paquete...>   desinstala y lo quita de tu lista
#   nanuk list                   muestra tu lista personal
#   nanuk sync                   instala todo lo de tu lista (máquina nueva)
#   nanuk update                 actualiza repo + sistema + AUR + flatpak + paquetes nuevos + dotfiles
#   nanuk webapp add|remove|list  apps web (Brave, ventana propia) con nombre + URL
#   nanuk menu                   menú: buscar/quitar paquetes, tema, fondo, actualizar...
#   nanuk theme [<tema>]          lista temas / cambia el activo
#   nanuk bg [<fondo>|next|none]  fondo de pantalla: lista, cambia, rota, negro puro
#   nanuk edit                   abre tu capa de config en $EDITOR
#   nanuk doctor                 diagnóstico rápido del sistema
#   nanuk help
# ─────────────────────────────────────────────────────────────────────
set -euo pipefail

# Raíz del repo: este script vive en <repo>/bin/nanuk (aunque se invoque
# por el symlink de ~/.local/bin).
SELF="$(readlink -f "${BASH_SOURCE[0]}")"
REPO="$(cd "$(dirname "$SELF")/.." && pwd)"

NANUK_CFG="$HOME/.config/nanuk"
LIST="$NANUK_CFG/user/packages.txt"

# Colores solo si la salida es una terminal.
if [[ -t 1 ]]; then B=$'\e[1m'; C=$'\e[36m'; Y=$'\e[33m'; R=$'\e[31m'; X=$'\e[0m'
else B=; C=; Y=; R=; X=; fi
say()  { echo "${C}▶${X} $*"; }
warn() { echo "${Y}⚠${X} $*" >&2; }
die()  { echo "${R}✖${X} $*" >&2; exit 1; }

ensure_list() { mkdir -p "$(dirname "$LIST")"; touch "$LIST"; }

# Ayudante del AUR: yay (el de Nanuk) o paru si la máquina ya lo trae.
# Vacío si no hay ninguno.
AUR="$(command -v yay || command -v paru || true)"

# ── Detección de origen ────────────────────────────────────────────
# Devuelve: repo | aur | flatpak | unknown
source_of() {
  local p="$1"
  if pacman -Si -- "$p" &>/dev/null; then
    echo repo
  elif [[ -n "$AUR" ]] && "$AUR" -Si -- "$p" &>/dev/null; then
    echo aur
  elif [[ "$p" == *.*.* ]] && flatpak remote-info --user flathub "$p" &>/dev/null; then
    echo flatpak
  else
    echo unknown
  fi
}

# Cómo se anota en packages.txt según el origen.
tag_for() {
  case "$1" in
    repo)    echo "$2" ;;
    aur)     echo "$2:aur" ;;
    flatpak) echo "flatpak:$2" ;;
  esac
}

record()   { ensure_list; grep -qxF "$1" "$LIST" || echo "$1" >> "$LIST"; }
# grep -v devuelve 1 si no queda ninguna línea (lista de un solo paquete):
# no es un error, por eso el `|| true` antes de mover el temporal.
unrecord() { ensure_list; grep -vxF "$1" "$LIST" > "$LIST.tmp" || true; mv "$LIST.tmp" "$LIST"; }

# ── Comandos ──────────────────────────────────────────────────────

cmd_install() {
  (( $# )) || die "uso: nanuk install <paquete...>"
  for p in "$@"; do
    local src; src="$(source_of "$p")"
    case "$src" in
      repo)    say "repo oficial → $p"; sudo pacman -S --needed --noconfirm -- "$p" ;;
      aur)     say "AUR → $p";          "$AUR" -S --needed --noconfirm -- "$p" ;;
      flatpak) say "flatpak → $p";      flatpak install --user -y flathub "$p" ;;
      *)       warn "no encuentro '$p' en repos, AUR ni flatpak — lo salto"; continue ;;
    esac
    record "$(tag_for "$src" "$p")"
    echo "  anotado en $LIST"
  done
}

cmd_remove() {
  (( $# )) || die "uso: nanuk remove <paquete...>"
  for p in "$@"; do
    if pacman -Qq -- "$p" &>/dev/null; then
      sudo pacman -Rns --noconfirm -- "$p"
    elif [[ "$p" == *.*.* ]] && flatpak info "$p" &>/dev/null; then
      flatpak uninstall --user -y "$p"
    else
      warn "'$p' no parece instalado"
    fi
    unrecord "$p"; unrecord "$p:aur"; unrecord "flatpak:$p"
    say "quitado: $p"
  done
}

cmd_list() {
  ensure_list
  if [[ -s "$LIST" ]]; then
    echo "${B}Tu lista personal${X} ($LIST):"
    sed 's/^/  /' "$LIST"
  else
    echo "Tu lista está vacía. Instala algo con: nanuk install <paquete>"
  fi
}

cmd_sync() {
  ensure_list
  [[ -s "$LIST" ]] || { echo "Lista vacía, nada que sincronizar."; return; }
  local repo=() aur=() fp=()
  while read -r line; do
    [[ -z "$line" || "$line" == \#* ]] && continue
    case "$line" in
      flatpak:*) fp+=("${line#flatpak:}") ;;
      *:aur)     aur+=("${line%:aur}") ;;
      *)         repo+=("$line") ;;
    esac
  done < "$LIST"

  (( ${#repo[@]} )) && { say "repos: ${repo[*]}"; sudo pacman -S --needed --noconfirm -- "${repo[@]}"; }
  if (( ${#aur[@]} )); then
    if [[ -n "$AUR" ]]; then
      say "AUR: ${aur[*]}"; "$AUR" -S --needed --noconfirm -- "${aur[@]}"
    else
      warn "sin ayudante del AUR (yay/paru); se omite: ${aur[*]}"
    fi
  fi
  (( ${#fp[@]}   )) && { say "flatpak: ${fp[*]}"; flatpak install --user -y flathub "${fp[@]}"; }
  say "sincronizado"
}

# ── Actualizar ───────────────────────────────────────────────────
STATE="$HOME/.local/state/nanuk"
PKG_COMMIT="$STATE/packages-commit"     # versión de las listas ya aplicada
REPO_LISTS=(base desktop dev 3dprint virt security)   # las de pacman, como 03

# Paquetes de uno o más archivos del repo (sin comentarios ni líneas vacías).
list_pkgs() { (cd "$REPO" && sed 's/#.*//' "$@" 2>/dev/null) | awk 'NF { print $1 }'; }

# changed_pkgs <+|-> <commit> <archivo...>: paquetes añadidos (+) o quitados
# (-) en esas listas entre <commit> y la versión actual del repo.
changed_pkgs() {
  local sign="$1" from="$2"; shift 2
  git -C "$REPO" diff -U0 "$from" HEAD -- "$@" 2>/dev/null \
    | sed -n "s/^[$sign]\([^$sign].*\)$/\1/p" | sed 's/#.*//' | awk 'NF { print $1 }'
}

# Paquetes NUEVOS de Nanuk (p. ej. fuzzel al cambiar de launcher). Compara las
# listas de la última vez (packages-commit, lo escriben install.sh y esto) con
# las de ahora e instala solo lo añadido: si quitaste algo de la base a
# propósito, no vuelve. Sin ese registro (instalaciones anteriores a esto) se
# instala, una vez, lo que falte de las listas de pacman.
update_packages() {
  local head from="" p
  head="$(git -C "$REPO" rev-parse HEAD 2>/dev/null)" \
    || { warn "$REPO no es un repo git: no puedo ver qué paquetes son nuevos"; return 0; }
  [[ -f "$PKG_COMMIT" ]] && from="$(<"$PKG_COMMIT")"
  local files=() l
  for l in "${REPO_LISTS[@]}"; do files+=("packages/$l.txt"); done

  local -a repo=() aur=() fp=() gone=()
  if [[ -n "$from" ]] && git -C "$REPO" cat-file -e "$from^{commit}" 2>/dev/null; then
    [[ "$from" != "$head" ]] || return 0
    mapfile -t repo < <(changed_pkgs + "$from" "${files[@]}")
    mapfile -t aur  < <(changed_pkgs + "$from" packages/aur.txt)
    mapfile -t fp   < <(changed_pkgs + "$from" packages/flatpak.txt)
    # Quitados de las listas y aún instalados: solo se avisa, no se borra nada.
    while read -r p; do
      pacman -Qq -- "$p" &>/dev/null && gone+=("$p")
    done < <(comm -23 <(changed_pkgs - "$from" 'packages/*.txt' | sort -u) <(nanuk_packages))
  else
    mapfile -t repo < <(list_pkgs "${files[@]}")
  fi

  # Fuera lo que ya está cubierto por otro paquete instalado (pacman -T cuenta
  # los "provides": nodejs-lts-jod satisface nodejs). Evita conflictos que,
  # con --noconfirm, abortarían la instalación.
  if (( ${#repo[@]} )); then
    mapfile -t repo < <(pacman -T "${repo[@]}" || true)
  fi
  if (( ${#repo[@]} )); then
    say "paquetes de Nanuk (repos): ${repo[*]:0:12}$( (( ${#repo[@]} > 12 )) && echo " …")"
    if sudo pacman -S --needed --noconfirm -- "${repo[@]}"; then
      sudo pacman -D --asexplicit -- "${repo[@]}" >/dev/null || true
    else
      warn "no se pudieron instalar todos: ${repo[*]}"
    fi
  fi
  if (( ${#aur[@]} )); then
    if [[ -n "$AUR" ]]; then
      say "paquetes nuevos de Nanuk (AUR): ${aur[*]}"
      "$AUR" -S --needed --noconfirm -- "${aur[@]}" || warn "falló parte del AUR: ${aur[*]}"
    else
      warn "sin ayudante del AUR; se omiten: ${aur[*]}"
    fi
  fi
  if (( ${#fp[@]} )) && command -v flatpak &>/dev/null; then
    say "flatpaks nuevos de Nanuk: ${fp[*]}"
    flatpak install --user -y --noninteractive flathub "${fp[@]}" || warn "falló parte de flatpak"
  fi
  if (( ${#gone[@]} )); then
    warn "Nanuk ya no usa: ${gone[*]}. Si no los quieres: nanuk remove ${gone[*]}"
  fi
  mkdir -p "$STATE"
  echo "$head" > "$PKG_COMMIT"
}

# ── ¿Hace falta reiniciar? ───────────────────────────────────────
# Tras actualizar no se dice "reinicia por si acaso": se mira qué cambió.
#   · Reiniciar: el kernel que está corriendo ya no está instalado (sus módulos
#     se borraron: un USB o la wifi podrían no cargar), o se actualizó algo del
#     arranque o de la base del sistema (systemd, glibc, mesa, microcode…).
#   · Cerrar sesión y volver a entrar: Hyprland y su pila, el audio, los
#     portales, o las variables/autostart de Nanuk.
REBOOT_PKGS='^(linux(-lts|-zen|-hardened|-rt)?|linux-firmware(-.+)?|systemd|systemd-libs|glibc|mesa|vulkan-(radeon|intel)|nvidia(-.+)?|intel-ucode|amd-ucode|cryptsetup|mkinitcpio|plymouth|limine|dbus|dbus-broker)$'
RELOGIN_PKGS='^(hyprland|aquamarine|hyprutils|hyprlang|hyprgraphics|hyprcursor|hyprwire|uwsm|xdg-desktop-portal(-hyprland|-gtk)?|wayland|pipewire|wireplumber|mako|hypridle|hyprlock|hyprpolkitagent)$'

# Paquetes instalados o actualizados desde la línea <n> de pacman.log (cada uno
# queda como "[ALPM] upgraded <paquete> (vieja -> nueva)").
updated_since() {
  tail -n +"$(( $1 + 1 ))" /var/log/pacman.log 2>/dev/null \
    | sed -nE 's/.*\[ALPM\] (upgraded|installed|reinstalled|downgraded) ([^ ]+) .*/\2/p' | sort -u
}

# ¿El kernel en marcha ya no está instalado? (mismo criterio que Omarchy: no
# queda ningún /usr/lib/modules/<versión>/vmlinuz de la versión de uname -r).
kernel_replaced() {
  local k found=0
  for k in /usr/lib/modules/*/vmlinuz; do
    [[ -f "$k" ]] || continue
    found=1
    [[ "$(basename "$(dirname "$k")")" == "$(uname -r)" ]] && return 1
  done
  (( found ))
}

# check_restart <línea de pacman.log antes de actualizar> <commit de Nanuk antes>
check_restart() {
  local log_start="$1" from="$2" p hypr
  local -a reboot=() relogin=()

  if kernel_replaced; then reboot+=("kernel (corre $(uname -r) y ya hay otro instalado)"); fi
  while read -r p; do
    [[ -n "$p" ]] || continue
    if [[ "$p" =~ $REBOOT_PKGS ]]; then reboot+=("$p")
    elif [[ "$p" =~ $RELOGIN_PKGS ]]; then relogin+=("$p"); fi
  done < <(updated_since "$log_start")

  # Hyprland reemplazado mientras corre: su ejecutable aparece como "(deleted)".
  hypr="$(pgrep -x Hyprland | head -n 1 || true)"
  if [[ -n "$hypr" && "$(readlink "/proc/$hypr/exe" 2>/dev/null)" == *"(deleted)"* ]]; then
    relogin+=("Hyprland (se actualizó mientras corría)")
  fi
  # Variables de entorno o autostart de Nanuk: solo se leen al entrar.
  if [[ -n "$from" ]] && git -C "$REPO" cat-file -e "$from^{commit}" 2>/dev/null \
     && ! git -C "$REPO" diff --quiet "$from" HEAD -- config/hypr/envs.lua config/hypr/autostart.lua; then
    relogin+=("variables o autostart de Nanuk")
  fi

  # Preguntar solo si hay alguien delante (terminal) y gum; si no, avisar.
  local ask=0
  [[ -t 0 && -t 1 ]] && command -v gum &>/dev/null && ask=1
  export GUM_CONFIRM_SELECTED_BACKGROUND="#9fd8ff" GUM_CONFIRM_SELECTED_FOREGROUND="#000000" \
         GUM_CONFIRM_UNSELECTED_BACKGROUND="#1e1e1e"
  echo
  if (( ${#reboot[@]} )); then
    echo "${Y}⚠${X} Hace falta ${B}reiniciar${X} por: $(IFS=,; echo "${reboot[*]}" | sed 's/,/, /g')"
    if (( ask )) && gum confirm "¿Reiniciar ahora?" --affirmative "Reiniciar ahora" --negative "Más tarde" --default=false; then
      systemctl reboot
    else
      echo "  Cuando quieras: Super+Esc → Reiniciar"
    fi
  elif (( ${#relogin[@]} )); then
    echo "${Y}⚠${X} Hace falta ${B}cerrar sesión y volver a entrar${X} por: $(IFS=,; echo "${relogin[*]}" | sed 's/,/, /g')"
    if (( ask )) && gum confirm "¿Cerrar sesión ahora? (guarda antes lo que tengas abierto)" --affirmative "Cerrar sesión" --negative "Más tarde" --default=false; then
      uwsm stop
    else
      echo "  Cuando quieras: Super+Esc → Cerrar sesión"
    fi
  else
    echo "✔ No hace falta reiniciar ni cerrar sesión."
  fi
}

cmd_update() {
  # NANUK_UPDATE_REEXEC: seguro contra bucles. Pase lo que pase, el relanzado
  # tras el pull ocurre UNA sola vez.
  if [[ "${1:-}" != --no-pull && -z "${NANUK_UPDATE_REEXEC:-}" ]]; then
    say "actualizando el repositorio de Nanuk..."
    if [[ -n "$(git -C "$REPO" status --porcelain 2>/dev/null)" ]]; then
      # Cambios locales en la copia del sistema (~/.local/share/nanuk; tu capa
      # user/ vive en otro sitio y no se toca). Se guardan en un stash en vez
      # de perderlos, y el pull ya no falla. Verlos: git -C <repo> stash list
      if git -C "$REPO" stash push --include-untracked -m "nanuk update $(date '+%F %T')" >/dev/null; then
        warn "había cambios locales en $REPO: guardados con git stash"
      fi
    fi
    git -C "$REPO" pull --ff-only || warn "no se pudo hacer pull (¿sin red?)"
    # El pull puede haber cambiado este mismo script: el resto lo hace la
    # versión nueva.
    NANUK_UPDATE_REEXEC=1 exec bash "$REPO/bin/nanuk" update --no-pull
  fi

  # Para saber al final qué se actualizó: hasta dónde llega hoy el log de
  # pacman y qué versión de Nanuk estaba aplicada (antes de que update_packages
  # la sobreescriba).
  local log_start from=""
  log_start="$(wc -l < /var/log/pacman.log 2>/dev/null || echo 0)"
  [[ -f "$PKG_COMMIT" ]] && from="$(<"$PKG_COMMIT")"

  say "actualizando el sistema (pacman)..."
  # OMARCHY_ALLOW_DIRECT_PACMAN=1: en una máquina que viene de Omarchy, su hook
  # 00-omarchy-update-guard aborta todo `pacman -Syu` que no lance `omarchy update`.
  # `env` hace que la variable llegue a pacman a través de sudo. En Arch sin
  # Omarchy nadie la lee.
  sudo env OMARCHY_ALLOW_DIRECT_PACMAN=1 pacman -Syu --noconfirm

  update_packages

  if [[ -n "$AUR" ]]; then
    say "actualizando el AUR..."
    "$AUR" -Sua --noconfirm || warn "algún paquete del AUR falló"
  fi

  if command -v flatpak &>/dev/null; then
    say "actualizando flatpak..."
    flatpak update --user -y || true
  fi

  say "re-desplegando la config por defecto (tu capa user/ no se toca)..."
  bash "$REPO/install/06-dotfiles.sh"

  # Dentro de Hyprland: aplicar ya la config nueva y que la barra la relea.
  if command -v hyprctl &>/dev/null && hyprctl version &>/dev/null; then
    hyprctl reload >/dev/null || true
    pkill -SIGUSR2 -x waybar || true
    say "Hyprland y la barra recargados"
  fi

  echo
  echo "${B}Listo.${X}"
  check_restart "$log_start" "$from"
}

cmd_theme() {
  local themes_dir="$NANUK_CFG/themes"
  if (( $# == 0 )); then
    echo "${B}Temas disponibles${X} (activo marcado con ●):"
    local active; active="$(basename "$(readlink -f "$NANUK_CFG/theme" 2>/dev/null || echo none)")"
    for t in "$themes_dir"/*/; do
      t="$(basename "$t")"
      [[ "$t" == "$active" ]] && echo "  ● $t" || echo "    $t"
    done
    return
  fi
  local name="$1"
  [[ -d "$themes_dir/$name" ]] || die "no existe el tema '$name' (mira: nanuk theme)"
  ln -sfn "themes/$name" "$NANUK_CFG/theme"
  say "tema activo: $name"
  command -v hyprctl &>/dev/null && hyprctl reload &>/dev/null || true
  echo "  (colores de Hyprland aplicados; hyprlock usa el wordmark del tema nuevo desde ya)"
  echo "  (el splash de arranque no cambia: para eso, bash $REPO/install/05-desktop.sh)"
}

# ── Apps web ─────────────────────────────────────────────────────
# nanuk webapp add "Nombre" https://url   → user/webapps/<slug>.desktop + enlace
# nanuk webapp remove <slug>
# nanuk webapp list
# El .desktop vive en TU capa (sobrevive a los updates) y se enlaza en
# ~/.local/share/applications para que salga en el launcher. Lo abre
# bin/nanuk-webapp (modo --app de Brave, --focus = enfocar si ya está abierta).
WEBAPPS_USER="$NANUK_CFG/user/webapps"
WEBAPPS_DEFAULT="$NANUK_CFG/default/webapps"
APPS_DIR="$HOME/.local/share/applications"

# "Google Maps" → google-maps
slugify() { tr '[:upper:]' '[:lower:]' <<<"$1" | sed -E 's/[^a-z0-9]+/-/g; s/^-+|-+$//g'; }

cmd_webapp() {
  local sub="${1:-list}"; shift || true
  case "$sub" in
    add)
      local name="${1:-}" url="${2:-}"
      [[ -n "$name" && -n "$url" ]] || die 'uso: nanuk webapp add "Nombre" https://url'
      [[ "$url" =~ ^https?:// ]] || url="https://$url"
      local slug; slug="$(slugify "$name")"
      [[ -n "$slug" ]] || die "no puedo sacar un nombre de archivo de '$name'"
      # Clase de ventana que pondrá Brave (brave-<host>__-Default): sirve para
      # que el launcher asocie la ventana a esta entrada.
      local host; host="$(sed -E 's#^[a-z]+://##; s#[/:].*$##' <<<"$url")"
      mkdir -p "$WEBAPPS_USER" "$APPS_DIR"
      cat > "$WEBAPPS_USER/$slug.desktop" <<EOF
[Desktop Entry]
Type=Application
Name=$name
Comment=App web ($host) en Brave
Exec=nanuk-webapp $url --focus
Icon=brave-origin
Terminal=false
Categories=Network;
StartupWMClass=brave-${host}__-Default
EOF
      ln -sfn "$WEBAPPS_USER/$slug.desktop" "$APPS_DIR/nanuk-webapp-$slug.desktop"
      command -v update-desktop-database &>/dev/null && update-desktop-database "$APPS_DIR" 2>/dev/null || true
      say "app web '$name' → $url"
      echo "  archivo: $WEBAPPS_USER/$slug.desktop (tu capa)"
      echo "  ya sale en el launcher. Atajo opcional en user/hypr/bindings.lua:"
      echo "    n.bind(\"SUPER + SHIFT + X\", \"$name\", \"nanuk-webapp $url --focus\")"
      ;;
    remove|rm)
      local slug="${1:-}"; [[ -n "$slug" ]] || die "uso: nanuk webapp remove <nombre>   (mira: nanuk webapp list)"
      slug="$(slugify "$slug")"
      if [[ -f "$WEBAPPS_USER/$slug.desktop" ]]; then
        rm -f "$WEBAPPS_USER/$slug.desktop" "$APPS_DIR/nanuk-webapp-$slug.desktop"
        say "quitada: $slug"
      elif [[ -f "$WEBAPPS_DEFAULT/$slug.desktop" ]]; then
        die "'$slug' viene con Nanuk (default/webapps), no es tuya. Para ocultarla del launcher: rm $APPS_DIR/nanuk-webapp-$slug.desktop (reaparece con el próximo update)"
      else
        die "no existe la app web '$slug' (mira: nanuk webapp list)"
      fi
      ;;
    list|ls)
      local f any=0
      echo "${B}Apps web${X} (nombre → URL)"
      for f in "$WEBAPPS_DEFAULT"/*.desktop "$WEBAPPS_USER"/*.desktop; do
        [[ -f "$f" ]] || continue
        any=1
        local origin="nanuk"; [[ "$f" == "$WEBAPPS_USER"/* ]] && origin="tuya"
        printf "  %-14s %-16s %s\n" "$(basename "$f" .desktop)" "[$origin]" \
          "$(sed -n 's/^Exec=nanuk-webapp \([^ ]*\).*/\1/p' "$f")"
      done
      (( any )) || echo "  ninguna. Añade una con: nanuk webapp add \"Nombre\" https://url"
      ;;
    *) die "uso: nanuk webapp add \"Nombre\" <url> | remove <nombre> | list" ;;
  esac
}

# ── Menú interactivo ─────────────────────────────────────────────
# Para quien no quiere aprenderse comandos: todo lo de arriba, con gum y fzf.
# Cada opción llama al mismo cmd_* que la CLI, así que el resultado es el
# mismo (y queda anotado en tu capa igual). Se abre con Super+Shift+I o con
# el copo de nieve de la barra, en una terminal flotante.

# fzf a juego con el tema: gris y blanco; hielo solo en el puntero (el foco).
FZF_NANUK=(
  --layout=reverse --info=inline-right --border=none --prompt="❯ "
  --color='bg:#000000,fg:#b0b0b0,hl:#ffffff,bg+:#141414,fg+:#ffffff,hl+:#ffffff,query:#ffffff'
  --color='pointer:#9fd8ff,marker:#9fd8ff,prompt:#707070,info:#505050,header:#909090,border:#333333,gutter:#000000'
  --preview-window='right,55%,wrap,border-left'
)

# Los paquetes que trae Nanuk (packages/*.txt), uno por línea.
nanuk_packages() {
  sed 's/#.*//; s/:aur$//' "$REPO"/packages/*.txt 2>/dev/null | awk 'NF { print $1 }' | sort -u
}

# Buscar e instalar: TODO lo instalable (repos oficiales + AUR) en una lista
# que se filtra al escribir, con la ficha del paquete a la derecha. Tab marca
# varios. Si escribes algo que no está en la lista (un id de flatpak como
# com.spotify.Client) y pulsas Enter, se instala eso tal cual.
menu_install() {
  local picks
  picks="$(
    {
      pacman -Sl 2>/dev/null | awk '{ printf "%s\t%s%s\n", $2, $1, ($4 ? "  · instalado" : "") }'
      [[ -n "$AUR" ]] && "$AUR" -Slqa 2>/dev/null | awk '{ printf "%s\taur\n", $1 }'
    } | fzf "${FZF_NANUK[@]}" --multi --delimiter='\t' --nth=1 --tiebreak=begin,length \
          --header='Instalar · escribe para buscar · Tab marca varios · Enter instala · Esc vuelve' \
          --preview="pacman -Si {1} 2>/dev/null || ${AUR:-false} -Si {1} 2>/dev/null" \
          --bind='enter:accept-or-print-query' \
      | cut -f1
  )" || true
  [[ -n "$picks" ]] || return 0
  # shellcheck disable=SC2086  # un paquete por palabra
  cmd_install $picks || true
}

# Quitar: lo que está instalado a propósito (pacman -Qe) + tus flatpaks. Lo
# que viene con Nanuk sale marcado y pide una confirmación más seria.
menu_remove() {
  local picks core
  picks="$(
    {
      pacman -Qeq | awk -v list="$(nanuk_packages | paste -sd,)" '
        BEGIN { n = split(list, a, ","); for (i = 1; i <= n; i++) nanuk[a[i]] = 1 }
        { printf "%s\t%s\n", $1, (($1 in nanuk) ? "viene con Nanuk" : "") }'
      command -v flatpak &>/dev/null \
        && flatpak list --user --app --columns=application 2>/dev/null | awk 'NF { printf "%s\tflatpak\n", $1 }'
    } | fzf "${FZF_NANUK[@]}" --multi --delimiter='\t' --nth=1 \
          --header='Quitar · Tab marca varios · Enter quita · Esc vuelve' \
          --preview='pacman -Qi {1} 2>/dev/null || flatpak info {1} 2>/dev/null' \
      | cut -f1
  )" || true
  [[ -n "$picks" ]] || return 0
  core="$(grep -xF -f <(nanuk_packages) <<<"$picks" || true)"
  if [[ -n "$core" ]]; then
    gum confirm "Vienen con Nanuk y quitarlos puede romper el escritorio: $(paste -sd' ' <<<"$core"). ¿Quitar igualmente?" || return 0
  else
    gum confirm "¿Quitar $(paste -sd' ' <<<"$picks")?" || return 0
  fi
  # shellcheck disable=SC2086
  cmd_remove $picks || true
}

cmd_menu() {
  command -v gum &>/dev/null || die "falta 'gum' (está en base.txt): sudo pacman -S gum"
  command -v fzf &>/dev/null || die "falta 'fzf' (está en base.txt): sudo pacman -S fzf"
  # Estética Nanuk: hielo solo en el cursor (el foco), el resto gris/blanco.
  export GUM_CHOOSE_CURSOR_FOREGROUND="#9fd8ff" GUM_CHOOSE_HEADER_FOREGROUND="#909090" \
         GUM_CHOOSE_SELECTED_FOREGROUND="#ffffff" GUM_INPUT_CURSOR_FOREGROUND="#9fd8ff" \
         GUM_INPUT_PROMPT_FOREGROUND="#909090" GUM_CONFIRM_SELECTED_BACKGROUND="#9fd8ff" \
         GUM_CONFIRM_SELECTED_FOREGROUND="#000000" GUM_CONFIRM_UNSELECTED_BACKGROUND="#1e1e1e"
  local choice
  while true; do
    echo
    choice="$(gum choose --header "nanuk · ¿qué quieres hacer?" \
      "Buscar e instalar paquetes" \
      "Quitar paquetes" \
      "Actualizar el sistema" \
      "Cambiar el tema" \
      "Cambiar el fondo de pantalla" \
      "Añadir una app web (nombre + URL)" \
      "Quitar una app web" \
      "Instalar un lenguaje" \
      "Diagnóstico (doctor)" \
      "Salir")" || return 0
    case "$choice" in
      "Buscar e instalar paquetes") menu_install ;;
      "Quitar paquetes")            menu_remove ;;
      "Actualizar el sistema")
        # En otro proceso: update se relanza a sí mismo tras el pull (exec) y
        # cerraría el menú.
        gum confirm "¿Actualizar Nanuk, sistema, AUR, flatpak y config por defecto?" \
          && { bash "$REPO/bin/nanuk" update || true; } ;;
      "Cambiar el tema")
        local theme active
        active="$(basename "$(readlink -f "$NANUK_CFG/theme" 2>/dev/null)")"
        theme="$(for d in "$NANUK_CFG/themes"/*/; do basename "$d"; done \
                 | gum choose --header "tema (activo: $active)")" || continue
        [[ -n "$theme" ]] || continue
        cmd_theme "$theme" ;;
      "Cambiar el fondo de pantalla")
        local bg
        bg="$( { "$REPO/bin/nanuk-bg" names; echo "none  (negro puro, sin imagen)"; } \
              | gum choose --header "fondo de pantalla (los tuyos van en ~/.config/nanuk/user/backgrounds/)")" || continue
        [[ -n "$bg" ]] || continue
        "$REPO/bin/nanuk-bg" "${bg%%  *}" || true ;;
      "Añadir una app web (nombre + URL)")
        local name url
        name="$(gum input --placeholder "Nombre (p. ej. YouTube)")" || continue
        url="$(gum input --placeholder "URL (p. ej. youtube.com)")" || continue
        [[ -n "$name" && -n "$url" ]] || continue
        cmd_webapp add "$name" "$url" || true ;;
      "Quitar una app web")
        local slug
        slug="$(for f in "$WEBAPPS_USER"/*.desktop; do [[ -f "$f" ]] && basename "$f" .desktop; done | gum choose --header "tus apps web")" || continue
        [[ -n "$slug" ]] || { echo "  no tienes apps web propias (las de Nanuk no se quitan desde aquí)"; continue; }
        cmd_webapp remove "$slug" || true ;;
      "Instalar un lenguaje")
        local lang
        lang="$(gum choose --header "lenguaje" rust node python go ruby java php r)" || continue
        cmd_lang "$lang" || true ;;
      "Diagnóstico (doctor)")
        cmd_doctor ;;
      "Salir"|"") return 0 ;;
    esac
  done
}

cmd_edit() {
  local ed="${EDITOR:-nvim}"
  exec "$ed" "$NANUK_CFG/user"
}

cmd_doctor() {
  echo "${B}nanuk doctor${X}"
  echo

  echo "· Servicios del sistema caídos:"
  systemctl --failed --no-legend --plain 2>/dev/null | sed 's/^/    /' | grep . \
    || echo "    ninguno ✔"

  echo "· Servicios de usuario caídos:"
  systemctl --user --failed --no-legend --plain 2>/dev/null | sed 's/^/    /' | grep . \
    || echo "    ninguno ✔"

  echo "· Enlaces de Nanuk rotos en ~/.config:"
  # Solo los symlinks que apuntan a la config de Nanuk (los que crea 06-dotfiles).
  local broken=0
  while IFS= read -r l; do
    [[ "$(readlink "$l")" == *"/nanuk/"* ]] && { echo "    $l"; broken=1; }
  done < <(find -L "$HOME/.config" -maxdepth 3 -type l 2>/dev/null)
  (( broken )) || echo "    ninguno ✔"

  echo "· Ayudante del AUR:"
  if [[ -n "$AUR" ]] && "$AUR" --version &>/dev/null; then
    echo "    $(basename "$AUR") ✔"
  else
    echo "    ${Y}sin ayudante del AUR${X} — ejecuta: bash $REPO/install/02-pacman.sh"
  fi

  echo "· Grupos de $USER:"
  for g in docker libvirt kvm; do
    id -nG "$USER" | grep -qw "$g" && echo "    $g ✔" || echo "    ${Y}falta $g${X} (cierra sesión si lo añadiste hace poco)"
  done

  echo "· Hyprland:"
  if command -v hyprctl &>/dev/null && hyprctl version &>/dev/null; then
    # hyprctl imprime el JSON con espacios ("tag": "v0.56.2"): jq, no grep.
    echo "    corriendo ✔ ($(hyprctl version -j 2>/dev/null | jq -r '.version // .tag // empty' 2>/dev/null))"
  else
    echo "    no está corriendo (normal si estás en una tty)"
  fi
}

cmd_lang() {
  if (( $# == 0 )); then
    cat <<'EOF'
Lenguajes y toolchains.   Uso: nanuk lang <nombre...>

  rust     rustup + toolchain 'stable'
  node     mise: node@lts (global)
  python   mise: python@latest (global; ya hay uno del sistema)
  go       mise: go@latest
  ruby     mise: ruby@latest
  java     mise: java@lts
  php      pacman: php + composer (ya viene de serie)
  r        pacman: r (no viene de serie; también está en packages/extras.txt)

Instalados ahora mismo:
EOF
    command -v rustc  &>/dev/null && echo "  rust    $(rustc --version 2>/dev/null | awk '{print $2}')"
    command -v node   &>/dev/null && echo "  node    $(node -v 2>/dev/null)"
    command -v python &>/dev/null && echo "  python  $(python --version 2>&1 | awk '{print $2}')"
    command -v go     &>/dev/null && echo "  go      $(go version 2>/dev/null | awk '{print $3}' | sed 's/go//')"
    command -v ruby   &>/dev/null && echo "  ruby    $(ruby -e 'print RUBY_VERSION' 2>/dev/null)"
    command -v php    &>/dev/null && echo "  php     $(php -r 'echo PHP_VERSION;' 2>/dev/null)"
    command -v R      &>/dev/null && echo "  r       $(R --version 2>/dev/null | awk 'NR==1{print $3}')"
    return 0
  fi

  for l in "$@"; do
    case "$l" in
      rust)
        sudo pacman -S --needed --noconfirm rustup
        rustup default stable ;;
      node|python|go|ruby|java)
        command -v mise &>/dev/null || die "falta 'mise' (está en dev.txt; re-ejecuta el paso 03)"
        case "$l" in
          node)   mise use -g node@lts ;;
          python) mise use -g python@latest ;;
          go)     mise use -g go@latest ;;
          ruby)   mise use -g ruby@latest ;;
          java)   mise use -g java@lts ;;
        esac ;;
      php)  sudo pacman -S --needed --noconfirm php composer ;;
      r)    sudo pacman -S --needed --noconfirm r ;;
      *)    warn "no sé instalar '$l' — mira: nanuk lang" ;;
    esac
    say "$l listo"
  done
}

usage() {
  cat <<'EOF'
nanuk — la CLI del sistema. En Nanuk conviven repos oficiales, AUR y flatpak.

  nanuk install <paquete...>   instala (repo | AUR | flatpak, lo detecta solo)
                               y lo anota en tu lista personal
  nanuk remove  <paquete...>   desinstala y lo quita de tu lista
  nanuk list                   muestra tu lista personal
  nanuk sync                   instala todo lo de tu lista (máquina nueva)
  nanuk update                 actualiza Nanuk (git pull), sistema, AUR, flatpak,
                               instala los paquetes nuevos de Nanuk y re-despliega la config
  nanuk webapp add "Nombre" <url>   crea una app web (Brave, ventana propia) en tu capa
  nanuk webapp remove <nombre> | list
  nanuk menu                   menú con buscador: paquetes, tema, fondo, actualizar (Super+Shift+I)
  nanuk theme [<tema>]         lista temas / cambia el activo
  nanuk bg [<fondo>|next|none] fondo de pantalla: lista / cambia / rota (Super+Shift+B) / negro puro
  nanuk lang [<lenguaje...>]   instala/lista lenguajes (rust node python go php r ...)
  nanuk keys                   chuleta de atajos de teclado (también Super+K)
  nanuk edit                   abre tu capa de config (~/.config/nanuk/user) en $EDITOR
  nanuk doctor                 diagnóstico rápido del sistema
  nanuk help
EOF
}

# ── Dispatch ──────────────────────────────────────────────────────
cmd="${1:-help}"; shift || true
case "$cmd" in
  install|i)   cmd_install "$@" ;;
  remove|rm)   cmd_remove "$@" ;;
  list|ls)     cmd_list ;;
  sync)        cmd_sync ;;
  update|up)   cmd_update "$@" ;;
  theme)       cmd_theme "$@" ;;
  bg|background) exec "$REPO/bin/nanuk-bg" "$@" ;;
  webapp|web)  cmd_webapp "$@" ;;
  menu|m)      cmd_menu ;;
  lang)        cmd_lang "$@" ;;
  keys)        exec nanuk-keys ;;
  edit)        cmd_edit ;;
  doctor)      cmd_doctor ;;
  help|-h|--help) usage ;;
  *)           warn "orden desconocida: $cmd"; usage; exit 1 ;;
esac
